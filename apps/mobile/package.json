{
  "name": "omni-bgc-m0-mobile",
  "version": "0.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "node --dns-result-order=ipv4first ./node_modules/expo/bin/cli start --dev-client --localhost --max-workers 2",
    "android": "expo run:android",
    "prebuild": "expo prebuild --platform android",
    "typecheck": "tsc --noEmit",
    "lint": "eslint App.tsx index.ts src",
    "format:check": "node scripts/format-authored.cjs",
    "format": "node scripts/format-authored.cjs --write",
    "check:dependencies": "node scripts/dependency-audit.cjs --check",
    "test:unit": "node --test ../../tests/refactoring/*.test.cjs",
    "test:integration": "python scripts/quality.py --output ../../.g/r1/quality",
    "check:style": "node scripts/check-local-style.mjs",
    "check:ui": "node scripts/check-ui-program.cjs"
  },
  "dependencies": {
    "@expo/vector-icons": "15.0.2",
    "@maplibre/maplibre-react-native": "11.5.0",
    "expo": "57.0.27",
    "expo-crypto": "57.0.3",
    "expo-dev-client": "57.0.19",
    "expo-file-system": "57.0.7",
    "expo-font": "57.0.4",
    "expo-location": "57.0.20",
    "expo-sensors": "~57.0.3",
    "expo-splash-screen": "57.0.9",
    "expo-sqlite": "57.0.4",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "2.32.0",
    "react-native-safe-area-context": "5.7.0"
  },
  "devDependencies": {
    "@types/geojson": "7946.0.16",
    "@types/react": "19.2.4",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2"
  }
}
